rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 150 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() < 1000)) &&
             (!('streak' in data) || data.streak is number) &&
             (!('lastActive' in data) || data.lastActive is string) &&
             data.createdAt is string;
    }

    function isValidFriendship(data) {
      return data.status in ['pending', 'accepted'] &&
             data.createdAt is string;
    }

    function isValidChat(data) {
      return data.participants is list && data.participants.size() >= 2 && data.participants.size() <= 100 &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() < 1000)) &&
             data.lastMessageTime is string &&
             (!('isUnread' in data) || data.isUnread is bool);
    }

    function isValidMessage(data) {
      return data.senderId is string && data.senderId.size() > 0 && data.senderId.size() < 100 &&
             data.text is string && data.text.size() < 5000 &&
             data.timestamp is string &&
             data.type in ['text', 'image', 'snap'] &&
             data.status in ['sent', 'delivered', 'read', 'opened'];
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.imageUrl is string && data.imageUrl.size() < 1000 &&
             data.timestamp is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow users to find friends
      allow create: if isOwner(userId) && hasRequiredFields(['uid', 'name', 'email', 'createdAt']) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified();
      allow delete: if isOwner(userId);
      
      match /friends/{friendId} {
        allow read: if isOwner(userId) || isOwner(friendId);
        allow create: if (isOwner(userId) || isOwner(friendId)) && hasRequiredFields(['status', 'createdAt']) && isValidFriendship(request.resource.data);
        allow update: if (isOwner(userId) || isOwner(friendId)) && isValidFriendship(request.resource.data);
        allow delete: if isOwner(userId) || isOwner(friendId);
      }
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants && hasRequiredFields(['participants', 'lastMessageTime']) && isValidChat(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants && isValidChat(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && hasRequiredFields(['senderId', 'text', 'timestamp', 'type', 'status']) && isValidMessage(request.resource.data) && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && isValidMessage(request.resource.data);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasRequiredFields(['userId', 'imageUrl', 'timestamp']) && isValidStory(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidStory(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
